{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:vrt": "vitest run --config vitest.config.ts",
    "test:vrt:update": "vitest run --config vitest.config.ts --update"
  },
  "dependencies": {
    "@lucide/vue": "1.72.0",
    "@vrc-ta-hub/client": "workspace:*",
    "gsap": "3.15.1",
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-router": "5.5.0"
  },
  "devDependencies": {
    "@pinia/testing": "2.0.2",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser-playwright": "5.1.0",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "10.6.2",
    "eslint-plugin-vue": "10.12.1",
    "playwright": "1.65.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vitest-browser-vue": "3.1.0",
    "vue-tsc": "3.3.14"
  }
}
