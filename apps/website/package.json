{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:vrt": "vitest run --config vitest.config.ts",
    "test:vrt:update": "vitest run --config vitest.config.ts --update"
  },
  "dependencies": {
    "@lucide/vue": "1.47.0",
    "@vrc-ta-hub/client": "workspace:*",
    "gsap": "3.15.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@pinia/testing": "2.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.8",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/browser-playwright": "5.0.1",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "10.6.1",
    "eslint-plugin-vue": "10.11.0",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vitest-browser-vue": "3.1.0",
    "vue-tsc": "3.3.11"
  }
}
